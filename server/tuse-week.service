[Unit]
Description=涂色周历 tenant store (127.0.0.1:18731)
After=network.target

[Service]
User=www
Group=www
Environment=TUSE_DB=/var/lib/tuse-week/data.db
Environment=TUSE_PORT=18731
ExecStart=/usr/bin/python3 /opt/tuse-week/server.py
Restart=always
RestartSec=2
MemoryMax=192M
CPUQuota=50%
TasksMax=64
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/tuse-week

[Install]
WantedBy=multi-user.target
